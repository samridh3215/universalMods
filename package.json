{
  "name": "universal-mods",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Claude-Code-style mods + a web control floor for Codex or Claude CLI agents",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc --noEmit && tsx src/server/build-check.ts",
    "test": "vitest run",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const r=p.join('node_modules','node-pty','prebuilds');if(fs.existsSync(r))for(const d of fs.readdirSync(r)){const f=p.join(r,d,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\"",
    "screenshots": "node scripts/screenshots.mjs",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/markdown-it": "^14.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
